      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(node_network_receive_bytes_total{device=~\"wlan0|eth0\"}[1m])",
          "legendFormat": "{{device}} RX",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(node_network_transmit_bytes_total{device=~\"wlan0|eth0\"}[1m])",
          "legendFormat": "{{device}} TX",
          "refId": "B"
        }
      ],
      "title": "Network Traffic (wlan0 / eth0)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "bytes"
